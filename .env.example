# Copy this file to .env and fill in ONE provider's key.

# Which LLM to use: groq | openai | google_genai | anthropic | ollama
LLM_PROVIDER=groq
# Optional: override the default model for that provider
# LLM_MODEL=llama-3.3-70b-versatile

# API keys (only the one for your provider is needed)
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# Ollama runs locally and needs no key: install it from ollama.com, then `ollama pull llama3.2`
